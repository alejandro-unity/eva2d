.sample-info-screen {
    flex-grow: 1;
    align-items: flex-end;
    padding: 16px;
}

.sample-info-panel {
    width: 420px;
    padding: 14px 16px;
    background-color: rgba(18, 18, 22, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
}

.sample-info-panel--hidden {
    display: none;
}

.sample-info-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 4px;
}

.sample-info-description {
    font-size: 13px;
    color: rgb(200, 200, 210);
    white-space: normal;
    margin-bottom: 6px;
}

.sample-info-section {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 170, 60);
    margin-top: 8px;
    margin-bottom: 2px;
}

.sample-info-item {
    font-size: 13px;
    color: rgb(230, 230, 236);
    white-space: normal;
    padding: 1px 0 1px 8px;
    margin: 0;
}

.sample-info-counters {
    font-size: 13px;
    color: rgb(140, 220, 170);
    white-space: normal;
}

.sample-info-hint {
    font-size: 11px;
    color: rgb(140, 140, 150);
    margin-top: 8px;
}
